# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
.env
.env.local
*.secret

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Raw Data: Ignore large multi-gigabyte raw files
data/raw/*
!data/raw/.gitkeep

# Ignore temporary local model weights if needed, but track deployment artifacts
# models/ and data/processed/ are included for Streamlit Cloud auto-deployment

# Streamlit config & cache
.streamlit/secrets.toml
