# AirSense Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your .env file to version control.

# ==========================================
# Alert Threshold Configuration
# ==========================================
# AQI threshold above which alerts will trigger (e.g., 200 = Unhealthy / Poor)
AQI_ALERT_THRESHOLD=200

# ==========================================
# Email Notification Settings (SMTP)
# ==========================================
# For Gmail, use an App Password (not your personal account password)
# Guide: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
ALERT_EMAIL_SENDER=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password
ALERT_EMAIL_RECIPIENT=recipient_email@gmail.com

# ==========================================
# Telegram Bot Notification Settings
# ==========================================
# Obtain bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Obtain your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# External API Keys (Optional)
# ==========================================
# Open-Meteo does not require an API key for standard usage.
# If using OpenAQ v3 API, provide your free API key here:
OPENAQ_API_KEY=your_openaq_api_key_if_applicable
